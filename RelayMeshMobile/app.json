{
  "expo": {
    "name": "RelayMeshMobile",
    "slug": "relaymesh-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.relaymeshmobile"
    },
    "plugins": [
      [
        "@config-plugins/react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Allow RelayMesh to connect to offline peers.",
          "bluetoothPeripheralPermission": "Allow RelayMesh to broadcast to offline peers."
        }
      ]
    ]
  }
}
